library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity top_tb is
end entity;

architecture sim of top_tb is

    constant CLK_PERIOD : time := 10 ns; -- 100 MHz

    -- Dla UART 115200:
    -- 100_000_000 / 115_200 ≈ 868 taktów
    constant BIT_TICKS : integer := 100_000_000 / 115_200;
    constant BIT_TIME  : time := CLK_PERIOD * BIT_TICKS;

    signal clk    : std_logic := '0';
    signal btnC   : std_logic := '0';

    -- UART idle state = '1'
    signal ble_rx : std_logic := '1';
    signal ble_tx : std_logic;

    signal led    : std_logic_vector(7 downto 0);

    -- Sygnały do monitorowania echa z ble_tx
    signal echo_data   : std_logic_vector(7 downto 0) := (others => '0');
    signal echo_toggle : std_logic := '0';

    procedure send_uart_byte(
        signal rx_line : out std_logic;
        data           : in  std_logic_vector(7 downto 0)
    ) is
    begin
        -- START bit
        rx_line <= '0';
        wait for BIT_TIME;

        -- DATA bits, UART wysyła LSB first
        for i in 0 to 7 loop
            rx_line <= data(i);
            wait for BIT_TIME;
        end loop;

        -- STOP bit
        rx_line <= '1';
        wait for BIT_TIME;
    end procedure;

begin

    --------------------------------------------------------------------
    -- Instancja testowanego modułu
    --------------------------------------------------------------------
    uut : entity work.top
        port map (
            clk    => clk,
            btnC   => btnC,
            ble_rx => ble_rx,
            ble_tx => ble_tx,
            led    => led
        );

    --------------------------------------------------------------------
    -- Generator zegara 100 MHz
    --------------------------------------------------------------------
    clk <= not clk after CLK_PERIOD / 2;

    --------------------------------------------------------------------
    -- Monitor ble_tx
    -- Ten proces cały czas nasłuchuje, czy FPGA odsyła echo.
    -- Dzięki temu nie gubimy początku ramki UART.
    --------------------------------------------------------------------
    monitor_tx_proc : process
        variable received_byte : std_logic_vector(7 downto 0);
    begin
        loop
            -- Czekamy na START bit na ble_tx
            wait until ble_tx = '0';

            -- Czekamy 1.5 czasu bitu:
            -- 1 bit startu + połowa pierwszego bitu danych
            wait for BIT_TIME + BIT_TIME / 2;

            -- Odczyt 8 bitów danych, LSB first
            for i in 0 to 7 loop
                received_byte(i) := ble_tx;
                wait for BIT_TIME;
            end loop;

            -- Teraz powinniśmy być w bicie STOP
            assert ble_tx = '1'
                report "ERROR: Brak poprawnego STOP bitu na ble_tx"
                severity error;

            echo_data <= received_byte;
            echo_toggle <= not echo_toggle;

            -- Dajemy czas na dokończenie bitu STOP
            wait for BIT_TIME / 2;
        end loop;
    end process;

    --------------------------------------------------------------------
    -- Główny proces testujący
    --------------------------------------------------------------------
    stim_proc : process
        variable old_echo_toggle : std_logic;
    begin

        -- RESET
        btnC <= '1';
        wait for 200 ns;
        btnC <= '0';
        wait for 200 ns;

        ----------------------------------------------------------------
        -- TEST 1: wysyłamy znak ASCII 'A' = 0x41
        ----------------------------------------------------------------
        report "TEST 1: Wysylam bajt 0x41";

        old_echo_toggle := echo_toggle;

        send_uart_byte(ble_rx, x"41");

        assert led = x"41"
            report "ERROR: LED-y nie pokazuja 0x41"
            severity error;

        -- Czekamy, aż monitor_tx_proc odbierze echo
        if echo_toggle = old_echo_toggle then
            wait until echo_toggle /= old_echo_toggle;
        end if;

        wait for 0 ns;

        assert echo_data = x"41"
            report "ERROR: Echo nie jest rowne 0x41"
            severity error;

        wait for BIT_TIME;


        ----------------------------------------------------------------
        -- TEST 2: wysyłamy 0xA5
        ----------------------------------------------------------------
        report "TEST 2: Wysylam bajt 0xA5";

        old_echo_toggle := echo_toggle;

        send_uart_byte(ble_rx, x"A5");

        assert led = x"A5"
            report "ERROR: LED-y nie pokazuja 0xA5"
            severity error;

        if echo_toggle = old_echo_toggle then
            wait until echo_toggle /= old_echo_toggle;
        end if;

        wait for 0 ns;

        assert echo_data = x"A5"
            report "ERROR: Echo nie jest rowne 0xA5"
            severity error;

        wait for BIT_TIME;


        ----------------------------------------------------------------
        -- TEST 3: wysyłamy 0xFF
        ----------------------------------------------------------------
        report "TEST 3: Wysylam bajt 0xFF";

        old_echo_toggle := echo_toggle;

        send_uart_byte(ble_rx, x"FF");

        assert led = x"FF"
            report "ERROR: LED-y nie pokazuja 0xFF"
            severity error;

        if echo_toggle = old_echo_toggle then
            wait until echo_toggle /= old_echo_toggle;
        end if;

        wait for 0 ns;

        assert echo_data = x"FF"
            report "ERROR: Echo nie jest rowne 0xFF"
            severity error;

        wait for BIT_TIME;


        ----------------------------------------------------------------
        -- Koniec testów
        ----------------------------------------------------------------
        report "WSZYSTKIE TESTY PRZESZLY POPRAWNIE" severity note;

        wait;
    end process;

end architecture;
